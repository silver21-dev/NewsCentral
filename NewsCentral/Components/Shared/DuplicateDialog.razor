@using NewsCentral.Models
@using NewsCentral.Authorization
@using NewsCentral.Ui
@implements IDisposable
@inject Services.PresentationService PresentationService
@inject Services.AuthenticationService AuthService
@inject Services.TeamService TeamService

@* Duplicates one presentation into many teams. The dialog owns the team selection and the run: it loads the
   authorable teams once when it opens (never on a later parameter set), reads the source once per run, then
   copies to each selected team one after another with progress, Stop and a summary. After a run the selection
   shrinks to the failed and unprocessed teams, so pressing the primary button again retries only those. *@

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="OverlayClicked">
        <div class="modal-content duplicate-dialog" @onclick:stopPropagation="true">
            <div class="dialog-icon"><span>📄</span></div>

            <h3>@Title</h3>
            <p>@Message</p>

            <div class="dialog-field">
                <TeamMultiSelect Teams="authorableTeams" Selection="selection"
                                 CurrentTeamId="@Source?.TeamID" CurrentTeamSuffix="@CurrentTeamSuffix"
                                 Disabled="running" OnSelectionChanged="StateHasChanged" />

                <BulkRunPanel TItem="Team" Running="running" Done="runDone" Total="runTotal" Verb="@verb"
                              Result="result" OnStop="Stop" ItemLabel="@(t => t.Name)" />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-2">@errorMessage</div>
                }
            </div>

            <div class="dialog-actions">
                <button @onclick="Close" class="btn btn-secondary" disabled="@running">
                    @(result != null ? CloseText : CancelText)
                </button>
                <button @onclick="Confirm" class="btn btn-primary" disabled="@(running || selection.Count == 0)">
                    @(ConfirmLabel?.Invoke(selection.Count) ?? selection.Count.ToString())
                </button>
            </div>
        </div>
    </div>
}

<style>
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        animation: fadeIn 0.2s;
    }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .duplicate-dialog {
        background: white;
        padding: 30px;
        border-radius: 10px;
        max-width: 640px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        animation: slideIn 0.3s;
    }

    @@keyframes slideIn {
        from { transform: translateY(-50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .dialog-icon { font-size: 48px; margin-bottom: 15px; }

    .duplicate-dialog h3 { margin: 0 0 15px 0; color: #333; }

    .duplicate-dialog p { color: #666; margin-bottom: 20px; line-height: 1.5; }

    .dialog-field { margin-bottom: 25px; text-align: left; }

    .dialog-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .dialog-actions .btn { min-width: 110px; }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Presentation? Source { get; set; }
    [Parameter] public string Title { get; set; } = "Duplicate presentation";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string CloseText { get; set; } = "Close";
    [Parameter] public string CurrentTeamSuffix { get; set; } = "(current team)";
    [Parameter] public Func<int, string>? ConfirmLabel { get; set; }

    /// <summary>Raised when the dialog closes; the argument is true when at least one copy succeeded while it was open.</summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private const string verb = "Duplicating";

    private List<Team> authorableTeams = new();
    private SelectionModel<string> selection = new();
    private BulkRunResult<Team>? result;
    private string? errorMessage;
    private bool anySucceeded;
    private bool running;
    private int runDone;
    private int runTotal;
    private bool wasVisible;
    private bool disposed;
    private CancellationTokenSource? cts;

    protected override async Task OnParametersSetAsync()
    {
        var opening = IsVisible && !wasVisible;
        wasVisible = IsVisible;

        // Load on the closed-to-open transition only; any other parameter set must not reload teams.
        if (!opening) return;

        selection = new SelectionModel<string>();
        result = null;
        errorMessage = null;
        anySucceeded = false;

        var user = AuthService.GetCurrentUser();
        var allTeams = await TeamService.GetAllTeamsAsync();
        authorableTeams = TeamAuthorization.AuthorableTeams(allTeams, user);
    }

    private async Task OverlayClicked()
    {
        if (!running) await Close();
    }

    private Task Close() => OnClose.InvokeAsync(anySucceeded);

    private void Stop() => cts?.Cancel();

    private async Task Confirm()
    {
        if (Source is null || running) return;

        var targets = authorableTeams
            .Where(t => selection.IsSelected(t.TeamID))
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (targets.Count == 0) return;

        result = null;
        errorMessage = null;
        running = true;
        runDone = 0;
        runTotal = targets.Count;

        Services.DuplicateSource source;
        try
        {
            source = await PresentationService.LoadDuplicateSourceAsync(Source.TeamFolderName, Source.PresentationID);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            running = false;
            return;
        }

        cts = new CancellationTokenSource();
        var progress = new InlineProgress(p =>
        {
            runDone = p.done;
            runTotal = p.total;
            if (!disposed) StateHasChanged();
        });

        BulkRunResult<Team> run;
        try
        {
            run = await BulkOperationRunner.RunAsync(
                targets,
                async t =>
                {
                    await PresentationService.DuplicateToTeamAsync(source, t.TeamID, t.FolderName);
                    return BulkItemOutcome.Success();
                },
                progress,
                cts.Token);
        }
        finally
        {
            cts.Dispose();
            cts = null;
        }

        if (disposed) return;

        result = run;
        if (run.SucceededCount > 0) anySucceeded = true;

        // Retry by shrinking the selection to the failed and unprocessed teams.
        selection.Clear();
        foreach (var team in BulkRetrySelection.Remaining(targets, run))
            selection.Set(team.TeamID, true);

        running = false;
    }

    public void Dispose()
    {
        disposed = true;
        try { cts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    // Progress.Report posts to the captured context; the runner already runs on the renderer's, so call straight through.
    private sealed class InlineProgress(Action<(int done, int total)> onReport) : IProgress<(int done, int total)>
    {
        public void Report((int done, int total) value) => onReport(value);
    }
}
