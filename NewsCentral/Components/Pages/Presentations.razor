@page "/presentations"
@using Microsoft.Extensions.Localization
@using NewsCentral.Models
@using NewsCentral.Services
@using NewsCentral.Components.Shared
@inject PresentationService PresentationService
@inject TeamContextService TeamContext
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject TeamService TeamService
@inject IStringLocalizer<Presentations> Localizer

<div class="presentations-container">
    <div class="page-header">
        <h2>@Localizer["PageTitle"]</h2>
        @if (!string.IsNullOrEmpty(currentTeamName))
        {
            <p class="team-name">@Localizer["TeamPrefix"] @currentTeamName</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    <div class="actions-bar">
        <button @onclick="CreateNewPresentation" class="btn btn-primary">
            @Localizer["CreatePresentation"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>@Localizer["LoadingPresentations"]</p>
        </div>
    }
    else if (presentations == null || presentations.Count == 0)
    {
        <div class="empty-state">
            <p>@Localizer["NoPresentationsFound"]</p>
            <button @onclick="CreateNewPresentation" class="btn btn-primary">
                @Localizer["CreateFirstPresentation"]
            </button>
        </div>
    }
    else
    {
        <div class="presentations-grid">
            @foreach (var presentation in presentations)
            {
                <div class="presentation-card">
                    @if (!string.IsNullOrEmpty(presentation.ContentImageBase64))
                    {
                        <div class="card-image">
                            <img src="data:image/jpeg;base64,@presentation.ContentImageBase64" alt="@presentation.Name" />
                        </div>
                    }

                    <div class="card-content">
                        <h3 class="card-title">@presentation.Name</h3>

                        <!-- NEW: Display type badges -->
                        @if (presentation.IsNewsOfWeek || presentation.IsWallpaper || presentation.IsLogonScreen)
                        {
                            <div class="display-badges-container">
                                <DisplayTypeBadges ShowNewsOfWeek="@presentation.IsNewsOfWeek"
                                                   ShowWallpaper="@presentation.IsWallpaper"
                                                   ShowLogonScreen="@presentation.IsLogonScreen" />
                            </div>
                        }

                        <p class="card-description">@Localizer["Comment"] @presentation.Description</p>

                        <div class="card-meta">
                            <span class="created-by">@Localizer["CreatedBy"] @GetCreatorName(presentation.CreatedBy)</span>
                        </div>

                        <div class="card-footer">
                            <span class="card-date">@Localizer["Created"] @presentation.DateCreated.ToString("yyyy-MM-dd")</span>
                            <span class="card-version">@Localizer["Version"] @presentation.Version</span>
                        </div>
                    </div>

                    <div class="card-actions">
                        <button @onclick="() => EditPresentation(presentation.PresentationID)"
                                class="btn btn-secondary">
                            @Localizer["Edit"]
                        </button>

                        <button @onclick="() => CreateAssignment(presentation.PresentationID)"
                                class="btn btn-primary">
                            @Localizer["CreateAssignment"]
                        </button>

                        <button @onclick="() => ShowDuplicate(presentation)"
                                class="btn btn-secondary">
                            @Localizer["Duplicate"]
                        </button>

                        @if (CanDelete(presentation))
                        {
                            <button @onclick="() => ShowDeleteConfirmation(presentation)"
                                    class="btn btn-danger">
                                @Localizer["Delete"]
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- NEW: Confirmation Dialog -->
<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="@Localizer["DeletePresentation"]"
               Message="@deleteConfirmMessage"
               ConfirmText="@Localizer["Delete"]"
               CancelText="@Localizer["Cancel"]"
               DialogType="danger"
               OnConfirm="ConfirmDeletePresentation"
               OnCancel="CancelDeletePresentation" />

<!-- NEW: Duplicate Dialog (team picker) -->
<DuplicateDialog IsVisible="@showDuplicate"
                 Source="@presentationToDuplicate"
                 Title="@Localizer["DuplicateTitle"]"
                 Message="@Localizer["DuplicateMessage"]"
                 CancelText="@Localizer["Cancel"]"
                 CloseText="@Localizer["Close"]"
                 CurrentTeamSuffix="@Localizer["CurrentTeamSuffix"]"
                 ConfirmLabel="DuplicateConfirmLabel"
                 OnClose="CloseDuplicate" />

<style>
    .presentations-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e0e0e0;
    }

        .page-header h2 {
            margin: 0 0 10px 0;
            color: #333;
            font-size: 32px;
        }

    .team-name {
        margin: 0;
        color: #667eea;
        font-size: 18px;
        font-weight: 600;
    }

    .actions-bar {
        margin-bottom: 30px;
        display: flex;
        justify-content: flex-end;
    }

    .alert {
        padding: 15px 20px;
        margin-bottom: 20px;
        border-radius: 5px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: #fee;
        border: 1px solid #fcc;
        color: #c33;
    }

    .alert-success {
        background-color: #efe;
        border: 1px solid #cfc;
        color: #3c3;
    }

    .loading {
        text-align: center;
        padding: 60px 20px;
        color: #666;
        font-size: 18px;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

        .empty-state p {
            font-size: 18px;
            color: #666;
            margin-bottom: 30px;
        }

    .presentations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .presentation-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .presentation-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

    .card-image {
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #f5f5f5;
    }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-content {
        padding: 20px;
        flex: 1;
    }

    .card-title {
        margin: 0 0 12px 0;
        font-size: 22px;
        font-weight: 600;
        color: #333;
    }

    .card-description {
        margin: 0 0 15px 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

    .card-meta {
        margin-bottom: 15px;
    }

    .created-by {
        font-size: 13px;
        color: #888;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid #eee;
        font-size: 13px;
        color: #888;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        padding: 15px 20px;
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
    }

    .btn {
        flex: 1;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .btn-primary:hover {
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background: #5a6268;
        }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background: #c82333;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }

    @@media (max-width: 768px) {
        .presentations-grid {
            grid-template-columns: 1fr;
        }

        .card-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }
    }

    .display-badges-container {
        margin: 10px 0 12px 0;
        min-height: 26px;
    }
</style>

@code {
    private List<Presentation> presentations = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string currentTeamName = string.Empty;

    // NEW: Delete confirmation state
    private bool showDeleteConfirm = false;
    private Presentation? presentationToDelete = null;
    private string deleteConfirmMessage = string.Empty;

    // NEW: Duplicate dialog state
    private bool showDuplicate = false;
    private Presentation? presentationToDuplicate = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadPresentations();
    }

    private async Task LoadPresentations()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var teamFolderName = TeamContext.GetCurrentTeamFolderName();

            if (string.IsNullOrEmpty(teamFolderName))
            {
                errorMessage = Localizer["NoTeamSelected"];
                return;
            }

            // Get team name for display
            var teams = await TeamService.GetAllTeamsAsync();
            var currentTeam = teams.FirstOrDefault(t => t.FolderName == teamFolderName);
            currentTeamName = currentTeam?.Name ?? teamFolderName;

            // Load presentations for current team
            presentations = await PresentationService.GetPresentationsForTeamAsync(teamFolderName);

            // Sort by most recent first
            presentations = presentations
                .OrderByDescending(p => p.DateCreated)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading presentations: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"LoadPresentations Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateNewPresentation()
    {
        Navigation.NavigateTo("/presentations/create");
    }

    private void EditPresentation(string presentationId)
    {
        Navigation.NavigateTo($"/presentations/edit/{presentationId}");
    }

    private void CreateAssignment(string presentationId)
    {
        Navigation.NavigateTo($"/presentations/{presentationId}/assign");
    }

    // NEW: Show delete confirmation
    private void ShowDeleteConfirmation(Presentation presentation)
    {
        if (!CanDelete(presentation))
        {
            errorMessage = Localizer["NoPermissionDelete"];
            return;
        }

        presentationToDelete = presentation;
        deleteConfirmMessage = string.Format(Localizer["DeleteConfirmMessage"].Value, presentation.Name);
        showDeleteConfirm = true;
    }

    // NEW: Confirm delete
    private async Task ConfirmDeletePresentation()
    {
        if (presentationToDelete == null) return;

        try
        {
            var teamFolderName = TeamContext.GetCurrentTeamFolderName();

            if (string.IsNullOrEmpty(teamFolderName))
            {
                errorMessage = Localizer["NoTeamCannotDelete"];
                showDeleteConfirm = false;
                presentationToDelete = null;
                return;
            }

            await PresentationService.DeletePresentationAsync(teamFolderName, presentationToDelete.PresentationID);

            successMessage = Localizer["DeleteSuccess"];
            showDeleteConfirm = false;
            presentationToDelete = null;

            await LoadPresentations();

            // Clear success message after 3 seconds
            await Task.Delay(3000);
            successMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting presentation: {ex.Message}";
            showDeleteConfirm = false;
            presentationToDelete = null;
        }
    }

    // NEW: Cancel delete
    private void CancelDeletePresentation()
    {
        showDeleteConfirm = false;
        presentationToDelete = null;
    }

    // NEW: Duplicate — open the team-picker modal for this presentation
    private void ShowDuplicate(Presentation presentation)
    {
        presentationToDuplicate = presentation;
        showDuplicate = true;
    }

    // The dialog owns the run and its summary; here we only close it and refresh when a copy was made.
    private async Task CloseDuplicate(bool anySucceeded)
    {
        showDuplicate = false;
        presentationToDuplicate = null;

        if (anySucceeded)
            await LoadPresentations();   // a copy shows here only when the current team was a target
    }

    private string DuplicateConfirmLabel(int count) => count == 1
        ? string.Format(Localizer["DuplicateToTeamsSingular"].Value, count)
        : string.Format(Localizer["DuplicateToTeamsPlural"].Value, count);

    private bool CanDelete(Presentation presentation)
    {
        var currentUser = AuthService.GetCurrentUser();
        if (currentUser == null) return false;
        if (AuthService.IsSystemAdmin()) return true;
        if (presentation.CreatedBy == currentUser.UserID) return true;

        // Any ContentAuthor of the current team can delete
        // regardless of who created the presentation
        var teamFolderName = TeamContext.GetCurrentTeamFolderName();
        return currentUser.TeamRoles.Any(tr =>
            tr.TeamFolderName == teamFolderName &&
            tr.Roles.Contains("ContentAuthor"));
    }

    private string GetCreatorName(string userId)
    {
        var currentUser = AuthService.GetCurrentUser();

        if (currentUser?.UserID == userId)
            return Localizer["CreatedByYou"];

        return Localizer["CreatedByTeamMember"];
    }
}
