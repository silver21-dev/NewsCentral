@page "/environment-management"
@using System.Diagnostics
@using System.Text
@using System.Threading
@using NewsCentral.Configuration
@using NewsCentral.Configuration.FleetExport
@using NewsCentral.Security
@using NewsCentral.Audit
@using NewsCentral.Services
@using NewsCentral.Components.Shared
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject EnvironmentContext EnvironmentContext
@inject EnvironmentSettingsService EnvironmentSettingsService
@inject EnvironmentDirectoryService EnvironmentDirectory
@inject DistributionServiceRouter DistributionRouter
@inject DistributionStatusTracker DistributionStatus
@inject AppConfiguration AppConfig
@inject IndexGenerationService IndexService
@inject EnvironmentKeyService KeyService
@inject TeamService TeamService
@inject IJSRuntime JS
@implements IDisposable

@* M5a — Environment Management page. TODO(i18n): plain English for now, following M3a/M4a. *@

<PageTitle>Environment Management</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Environment Management</h1>
        <p class="page-description">Distribution settings for the current environment.</p>
    </div>

    @if (isAuthorized)
    {
        @* ── 1. Current environment ─────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5><i class="bi bi-hdd-network me-2"></i>Current environment</h5></div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Display name:</strong></div>
                    <div class="col-md-9">@current?.DisplayName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>DataPath:</strong></div>
                    <div class="col-md-9"><code>@EnvironmentContext.DataPath</code></div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Kind:</strong></div>
                    <div class="col-md-9">
                        @if (current?.Kind == EnvironmentKind.Policy)
                        {
                            <span class="badge bg-secondary me-1">policy</span>
                        }
                        @if (current?.Kind == EnvironmentKind.Shared)
                        {
                            <span class="badge bg-info text-dark me-1">shared</span>
                        }
                        @if (current != null && !current.IsShareable)
                        {
                            <span class="badge bg-light text-dark me-1">this computer only</span>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Settings source:</strong></div>
                    <div class="col-md-9">@sourceText</div>
                </div>
                @if (effective?.PolicyEnvironmentName != null)
                {
                    <div class="row mb-2">
                        <div class="col-md-3"></div>
                        <div class="col-md-9 text-muted">managed by policy: @effective.PolicyEnvironmentName</div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col-md-3"></div>
                    <div class="col-md-9">
                        <button class="btn btn-outline-secondary" @onclick="OpenExportDialogAsync"
                                disabled="@(!CanExportFleetSettings)"
                                title="@(CanExportFleetSettings ? "Generate NewsService/NewsViewer registry settings for this environment" : "Fix the settings source (currently Invalid or Unreachable) before exporting fleet settings")">
                            <i class="bi bi-download me-2"></i>Export fleet settings
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* ── 2. Distribution status ─────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5><i class="bi bi-cloud-upload me-2"></i>Distribution status</h5></div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Target:</strong></div>
                    <div class="col-md-9"><code>@targetText</code></div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Fingerprint:</strong></div>
                    <div class="col-md-9"><code>@(effective?.DistributionFingerprint ?? "—")</code></div>
                </div>
                @if (routerConfigurationError != null)
                {
                    <div class="row mb-2">
                        <div class="col-md-3"><strong>Configuration error:</strong></div>
                        <div class="col-md-9 text-danger">@routerConfigurationError</div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Last success:</strong></div>
                    <div class="col-md-9">@(DistributionStatus.LastSuccessUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Last failure:</strong></div>
                    <div class="col-md-9">
                        @(DistributionStatus.LastFailureUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
                        @if (DistributionStatus.LastFailureReason != null)
                        {
                            <text> — @(DistributionStatus.LastFailureReason.TrimEnd('.'))</text>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── 3. Settings editor ─────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5><i class="bi bi-gear me-2"></i>Settings</h5></div>
            <div class="card-body">
                @if (startNote != null)
                {
                    <div class="alert alert-info">@startNote</div>
                }
                @if (sourceErrorText != null)
                {
                    <div class="alert alert-warning">@sourceErrorText</div>
                }
                @if (validationErrors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in validationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                @if (saveError != null)
                {
                    <div class="alert alert-danger">@saveError</div>
                }

                <AclDriftWarnings />

                <div class="mb-3">
                    <label class="form-label">Display name</label>
                    @if (IsPolicyField("displayName"))
                    {
                        <input class="form-control" value="@formDisplayName" disabled />
                        <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                    }
                    else
                    {
                        <input class="form-control" @bind="formDisplayName" @bind:after="MarkDirty" />
                    }
                </div>

                @* TODO(i18n). SecurePath is not policy-controllable. *@
                <div class="mb-3">
                    <label class="form-label">Secure path (team signing keys)</label>
                    <input class="form-control" @bind="formSecurePath" @bind:after="MarkDirty"
                           placeholder="(defaults to DataPath\secure if left blank)" />
                    <small class="text-muted">
                        Currently: @EnvironmentSettingsResolver.EffectiveSecurePath(BuildFormSettings(), EnvironmentContext.DataPath).
                        Changing this does not move existing keys. Folder permissions are set by the provisioning script, not by this app.
                    </small>
                </div>

                @* TODO(i18n). Audit toggle: the policy registry value Audit Enabled, when present, locks it. *@
                <div class="mb-3">
                    <label class="form-label">Audit path</label>
                    <input class="form-control" @bind="formAuditPath" @bind:after="MarkDirty"
                           placeholder="(defaults to DataPath\audit if left blank)" />
                    <small class="text-muted">
                        Currently: @AuditSettingsResolver.EffectiveAuditPath(BuildFormSettings(), EnvironmentContext.DataPath).
                    </small>
                </div>

                <div class="mb-3 form-check">
                    @if (AppConfig.AuditEnabledOverride.HasValue)
                    {
                        <input type="checkbox" class="form-check-input" checked="@AppConfig.AuditEnabledOverride.Value" disabled />
                        <label class="form-check-label">
                            Audit log enabled
                            <small class="text-muted ms-2"><i class="bi bi-lock me-1"></i>set by policy</small>
                        </label>
                    }
                    else
                    {
                        <input type="checkbox" class="form-check-input" id="auditEnabled" @bind="formAuditEnabled" @bind:after="MarkDirty" />
                        <label class="form-check-label" for="auditEnabled">Audit log enabled</label>
                    }
                </div>

                <div class="mb-3 form-check">
                    @if (IsPolicyField("distribution.enabled"))
                    {
                        <input type="checkbox" class="form-check-input" checked="@formDistributionEnabled" disabled />
                        <label class="form-check-label">
                            Distribution enabled <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                        </label>
                    }
                    else
                    {
                        <input type="checkbox" class="form-check-input" id="distEnabled" @bind="formDistributionEnabled" @bind:after="MarkDirty" />
                        <label class="form-check-label" for="distEnabled">Distribution enabled</label>
                    }
                </div>

                @if (formDistributionEnabled)
                {
                    <div class="mb-3">
                        <label class="form-label">Mode</label>
                        @if (IsPolicyField("distribution.mode"))
                        {
                            <input class="form-control" value="@formMode" disabled />
                            <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                        }
                        else
                        {
                            <select class="form-select" @bind="formMode" @bind:after="MarkDirty">
                                <option value="Local">Local</option>
                                <option value="AzureBlob">AzureBlob</option>
                            </select>
                        }
                    </div>

                    @if (string.Equals(formMode, "AzureBlob", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mb-3">
                            <label class="form-label">Tenant ID</label>
                            @if (IsPolicyField("distribution.azureBlob.tenantId"))
                            {
                                <input class="form-control" value="@formAzureTenantId" disabled />
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                            }
                            else
                            {
                                <input class="form-control" @bind="formAzureTenantId" @bind:after="MarkDirty" />
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Client ID</label>
                            @if (IsPolicyField("distribution.azureBlob.clientId"))
                            {
                                <input class="form-control" value="@formAzureClientId" disabled />
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                            }
                            else
                            {
                                <input class="form-control" @bind="formAzureClientId" @bind:after="MarkDirty" />
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Account name</label>
                            @if (IsPolicyField("distribution.azureBlob.accountName"))
                            {
                                <input class="form-control" value="@formAzureAccountName" disabled />
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                            }
                            else
                            {
                                <input class="form-control" @bind="formAzureAccountName" @bind:after="MarkDirty" />
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Container name</label>
                            @if (IsPolicyField("distribution.azureBlob.containerName"))
                            {
                                <input class="form-control" value="@formAzureContainerName" disabled />
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                            }
                            else
                            {
                                <input class="form-control" @bind="formAzureContainerName" @bind:after="MarkDirty" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Local path</label>
                            @if (IsPolicyField("distribution.localPath"))
                            {
                                <input class="form-control" value="@formLocalPath" disabled />
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>set by policy</small>
                            }
                            else
                            {
                                <input class="form-control" @bind="formLocalPath" @bind:after="MarkDirty"
                                       placeholder="(defaults to DataPath\_distribution if left blank)" />
                            }
                        </div>
                    }
                }

                @if (testResult != null)
                {
                    <div class="alert @(IsTestSuccess(testResult) ? "alert-success" : "alert-warning")">@testResult</div>
                }

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="RunTestAsync" disabled="@isTesting">
                        @(isTesting ? "Testing…" : "Test")
                    </button>
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                        @(isSaving ? "Saving…" : "Save")
                    </button>
                </div>

                @if (showRegenerateOffer)
                {
                    <div class="alert @(regenerateFailures.Count > 0 ? "alert-warning" : "alert-success") mt-3">
                        Settings saved.
                        <button class="btn btn-sm btn-outline-success ms-2" @onclick="RegenerateAllAsync" disabled="@isRegenerating">
                            @(isRegenerating ? "Regenerating…" : "Regenerate all team indexes now")
                        </button>
                        @if (regenerateSummary != null)
                        {
                            <div class="mt-2">@regenerateSummary</div>
                        }
                        @if (regenerateFailures.Count > 0)
                        {
                            <ul class="mb-0 mt-1">
                                @foreach (var failure in regenerateFailures)
                                {
                                    <li>@failure.TrimEnd('.')</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── 4. Same distribution target ────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5><i class="bi bi-diagram-3 me-2"></i>Same distribution target</h5></div>
            <div class="card-body">
                @if (!isCurrentShared)
                {
                    <p class="text-muted mb-0">This environment is not in the shared directory — collision check not available.</p>
                }
                else if (collisions.Count == 0)
                {
                    <p class="text-muted mb-0">No other shared environment uses this target.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var collision in collisions)
                        {
                            var name = string.IsNullOrWhiteSpace(collision.DisplayName) ? collision.DataPath : collision.DisplayName;
                            <li>@name (@collision.DataPath) publishes to the same target.</li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* ── 5. Initialize an environment (M5b) ─────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5><i class="bi bi-plus-square me-2"></i>Initialize an environment</h5></div>
            <div class="card-body">
                <p class="text-muted">
                    Probes a path and, if it exists and is not already initialized, opens the setup
                    wizard to create its first System Administrator.
                </p>
                <div class="mb-3">
                    <label class="form-label">Path</label>
                    <input class="form-control" @bind="initPath" @bind:event="oninput" disabled="@isInitializingTarget"
                           placeholder="\\server\share\newscentral or C:\NewsCentral" />
                </div>
                @if (OtherEnvironmentOptions.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label">Or pick a listed environment</label>
                        <select class="form-select" @onchange="PickOtherEnvironment" disabled="@isInitializingTarget">
                            <option value="">— select —</option>
                            @foreach (var option in OtherEnvironmentOptions)
                            {
                                <option value="@option.DataPath">@option.DisplayName (@option.DataPath)</option>
                            }
                        </select>
                    </div>
                }
                @if (initError != null)
                {
                    <div class="alert alert-danger">@initError</div>
                }

                <button class="btn btn-outline-secondary" @onclick="InitializeTargetAsync" disabled="@isInitializingTarget">
                    @(isInitializingTarget ? "Checking…" : "Initialize…")
                </button>

                @if (initCreated)
                {
                    <div class="alert alert-success mt-3">
                        Environment @initCreatedName initialized.
                        <button class="btn btn-sm btn-outline-success ms-2" @onclick="SwitchToInitialized">
                            Switch to it now
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<EnvironmentSetupWizard IsVisible="showInitWizard"
                        TargetPath="@initWizardTargetPath"
                        CreateRootIfMissing="false"
                        AddToDirectory="true"
                        PrefillDistribution="@(effective?.StoredSettings ?? EnvironmentSettingsService.GetMachineDefaults())"
                        OnCreated="HandleInitWizardCreated"
                        OnCancelled="HandleInitWizardCancelled" />

<ConfirmDialog IsVisible="showRetargetConfirm"
               Title="Change distribution target?"
               Message="@retargetMessage"
               ConfirmText="Continue"
               CancelText="Cancel"
               DialogType="warning"
               OnConfirm="ConfirmSaveAsync"
               OnCancel="CancelRetarget" />

@* M6 — fleet settings export dialog. A bespoke modal (not the shared ConfirmDialog, whose shape
   is title/message/confirm-cancel only) reusing ConfirmDialog's own .modal-overlay/.modal-content
   styles — both are global, not CSS-isolated, since neither this page nor ConfirmDialog uses a
   co-located .razor.css file. *@
@if (showExportDialog && exportResult != null)
{
    <div class="modal-overlay" @onclick="CloseExportDialog">
        <div class="modal-content export-dialog" @onclick:stopPropagation="true">
            <h3>Export fleet settings</h3>

            @if (exportResult.Warnings.Count > 0)
            {
                <div class="alert alert-warning">
                    <strong>Warnings:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var warning in exportResult.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            @if (exportResult.Placeholders.Count > 0)
            {
                <div class="mb-3">
                    <strong>Placeholders — replace before use:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var placeholder in exportResult.Placeholders)
                        {
                            <li><code>@placeholder</code></li>
                        }
                    </ul>
                </div>
            }

            <div class="export-tabs">
                <button type="button" class="btn btn-sm @(exportActiveTab == "powershell" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="@(() => exportActiveTab = "powershell")">
                    PowerShell (pilot machines)
                </button>
                <button type="button" class="btn btn-sm @(exportActiveTab == "reg" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="@(() => exportActiveTab = "reg")">
                    .reg (GPO hand-off)
                </button>
            </div>

            @if (exportActiveTab == "powershell")
            {
                <textarea class="export-textarea" readonly>@exportResult.PowerShell</textarea>
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="@(() => CopyExportTextAsync(exportResult.PowerShell))">
                    <i class="bi bi-clipboard me-1"></i>Copy
                </button>
            }
            else
            {
                <textarea class="export-textarea" readonly>@exportResult.Reg</textarea>
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="@(() => CopyExportTextAsync(exportResult.Reg))">
                    <i class="bi bi-clipboard me-1"></i>Copy
                </button>
            }

            @if (!string.IsNullOrEmpty(exportCopyFeedback))
            {
                <div class="text-muted small mt-1">@exportCopyFeedback</div>
            }

            @if (exportSaveError != null)
            {
                <div class="alert alert-danger mt-3">@exportSaveError</div>
            }

            @if (exportSavedPs1Path != null)
            {
                <div class="alert alert-success mt-3">
                    Saved:
                    <div><code>@exportSavedPs1Path</code></div>
                    <div><code>@exportSavedRegPath</code></div>
                    <button class="btn btn-sm btn-outline-success mt-2" @onclick="OpenExportFolder">Open folder</button>
                </div>
            }

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-secondary" @onclick="CloseExportDialog">Close</button>
                <button class="btn btn-primary" @onclick="SaveExportToDownloads">Save to Downloads</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-content.export-dialog {
        max-width: 800px;
        width: 90%;
        text-align: left;
    }

    .export-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 10px;
    }

    .export-textarea {
        display: block;
        width: 100%;
        height: 320px;
        font-family: Consolas, 'Courier New', monospace;
        font-size: 12px;
        white-space: pre;
        overflow: auto;
        resize: vertical;
        box-sizing: border-box;
    }
</style>

@code {
    private bool isAuthorized;
    private EnvironmentOption? current;
    private EffectiveEnvironmentSettings? effective;
    private string? routerConfigurationError;
    private string sourceText = string.Empty;
    private string? sourceErrorText;
    private string? startNote;
    private string targetText = string.Empty;

    private string? formDisplayName;
    private bool formDistributionEnabled;
    private string formMode = "Local";
    private string? formLocalPath;
    private string? formSecurePath;
    private string? formAuditPath;
    private bool formAuditEnabled = true;
    private string? formAzureTenantId;
    private string? formAzureClientId;
    private string? formAzureAccountName;
    private string? formAzureContainerName;

    private IReadOnlyList<string> policyFields = Array.Empty<string>();
    private List<string> validationErrors = new();

    private bool showRetargetConfirm;
    private string? retargetMessage;
    private EnvironmentSettings? pendingSettings;
    private string? pendingNewFingerprint;

    private bool isSaving;
    private string? saveError;
    private bool showRegenerateOffer;
    private bool isRegenerating;
    private string? regenerateSummary;
    private List<string> regenerateFailures = new();

    private bool isTesting;
    private string? testResult;

    private bool isCurrentShared;
    private IReadOnlyList<SharedDirectoryEntry> collisions = Array.Empty<SharedDirectoryEntry>();

    // M5a.1: true once the user has touched any editable field — an external reload (another save
    // elsewhere, a distribution status change) must never clobber in-progress edits.
    private bool isDirty;

    // M6 — Export fleet settings.
    private bool showExportDialog;
    private FleetExport? exportResult;
    private string exportActiveTab = "powershell";
    private string? exportCopyFeedback;
    private string? exportSaveError;
    private string? exportSavedPs1Path;
    private string? exportSavedRegPath;
    private string? exportSavedFolder;

    private bool CanExportFleetSettings =>
        effective != null &&
        effective.Source != EnvironmentSettingsSource.Invalid &&
        effective.Source != EnvironmentSettingsSource.Unreachable;

    // M5b — "Initialize an environment".
    private string initPath = string.Empty;
    private bool isInitializingTarget;
    private string? initError;
    private bool showInitWizard;
    private string initWizardTargetPath = string.Empty;
    private bool initCreated;
    private string? initCreatedName;
    private string? initCreatedPath;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthService.GetCurrentUser();
        if (user == null || !user.IsSystemAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }

        isAuthorized = true;
        EnvironmentSettingsService.SettingsChanged += HandleExternalChange;
        DistributionStatus.Changed += HandleExternalChange;

        await LoadReadOnlySectionsAsync();
        FillFormFromEffective();
    }

    public void Dispose()
    {
        EnvironmentSettingsService.SettingsChanged -= HandleExternalChange;
        DistributionStatus.Changed -= HandleExternalChange;
    }

    private void MarkDirty() => isDirty = true;

    /// <summary>
    /// Fired by EnvironmentSettingsService.SettingsChanged (a save made anywhere — this page's own,
    /// or elsewhere, e.g. MainLayout's "Save to environment") and DistributionStatusTracker.Changed
    /// (a distribution success/failure). Reloads only the read-only sections — never the success
    /// panel, the regenerate offer/summary, or the Test result — and refills the form only when
    /// there are no unsaved edits.
    /// </summary>
    private async void HandleExternalChange()
    {
        try
        {
            await LoadReadOnlySectionsAsync();
            if (!isDirty)
                FillFormFromEffective();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[EnvironmentManagement] Failed to refresh after an external change: {ex.Message}");
        }
    }

    private async Task LoadReadOnlySectionsAsync()
    {
        current = EnvironmentDirectory.Current;
        effective = await EnvironmentSettingsService.GetAsync();

        // Forces the router to build (if it hasn't yet this session) so ConfigurationError
        // reflects the CURRENT settings even if nothing has actually tried to distribute anything.
        await DistributionRouter.EnsureBuiltAsync();
        routerConfigurationError = DistributionRouter.ConfigurationError;

        policyFields = effective.PolicyFields;

        sourceText = effective.Source switch
        {
            EnvironmentSettingsSource.EnvironmentFile => "Environment file",
            EnvironmentSettingsSource.MachineDefaults => "This machine's defaults",
            EnvironmentSettingsSource.Unreachable => "Could not be read",
            _ => "Invalid"
        };

        if (effective.Source == EnvironmentSettingsSource.EnvironmentFile ||
            effective.Source == EnvironmentSettingsSource.MachineDefaults)
        {
            startNote = effective.Source == EnvironmentSettingsSource.MachineDefaults
                ? "Not yet stored in this environment — Save stores them."
                : null;
            sourceErrorText = null;
        }
        else // Invalid / Unreachable
        {
            startNote = "Saving replaces the stored settings.";
            sourceErrorText = effective.Error;
        }

        targetText = effective.Settings != null
            ? EnvironmentSettingsService.DescribeDistributionTarget(effective.Settings.Distribution, EnvironmentContext.DataPath)
            : "—";

        RefreshCollisions();
    }

    /// <summary>
    /// Fills the editable form from the CURRENT effective (policy-applied) settings — the file/
    /// machine-default values for EnvironmentFile/MachineDefaults, or this machine's own defaults
    /// for Invalid/Unreachable (effective.Settings is null there). Only ever called when there are
    /// no unsaved edits (on initial load, right after this page's own successful Save, or from
    /// HandleExternalChange when !isDirty) — never during a reload that must preserve in-progress
    /// edits.
    /// </summary>
    private void FillFormFromEffective()
    {
        var baseSettings = effective!.Source == EnvironmentSettingsSource.EnvironmentFile ||
                            effective.Source == EnvironmentSettingsSource.MachineDefaults
            ? effective.Settings!
            : EnvironmentSettingsResolver.FromMachineConfiguration(AppConfig);

        formDisplayName = baseSettings.DisplayName;
        formDistributionEnabled = baseSettings.Distribution.Enabled;
        formMode = baseSettings.Distribution.Mode;
        formLocalPath = baseSettings.Distribution.LocalPath;
        formSecurePath = baseSettings.SecurePath;
        formAuditPath = baseSettings.AuditPath;
        formAuditEnabled = baseSettings.Audit.Enabled;
        formAzureTenantId = baseSettings.Distribution.AzureBlob.TenantId;
        formAzureClientId = baseSettings.Distribution.AzureBlob.ClientId;
        formAzureAccountName = baseSettings.Distribution.AzureBlob.AccountName;
        formAzureContainerName = baseSettings.Distribution.AzureBlob.ContainerName;

        isDirty = false;
    }

    private void RefreshCollisions()
    {
        isCurrentShared = EnvironmentDirectory.FindCurrentSharedEntry() != null;
        collisions = EnvironmentChangeRules.FindCollisions(
            EnvironmentContext.DataPath, effective?.DistributionFingerprint, EnvironmentDirectory.SharedEntries);
    }

    private bool IsPolicyField(string name) => policyFields.Contains(name);

    private static bool IsTestSuccess(string result) =>
        result == "OK" || result.StartsWith("Container exists", StringComparison.Ordinal);

    private EnvironmentSettings BuildFormSettings() => new()
    {
        SchemaVersion = EnvironmentSettingsResolver.CurrentSchemaVersion,
        DisplayName = string.IsNullOrWhiteSpace(formDisplayName) ? null : formDisplayName,
        SecurePath = string.IsNullOrWhiteSpace(formSecurePath) ? null : formSecurePath.Trim(),
        AuditPath = string.IsNullOrWhiteSpace(formAuditPath) ? null : formAuditPath.Trim(),
        Audit = new AuditSettingsSection { Enabled = formAuditEnabled },
        Distribution = new DistributionSettings
        {
            Enabled = formDistributionEnabled,
            Mode = formMode,
            LocalPath = string.IsNullOrWhiteSpace(formLocalPath) ? null : formLocalPath,
            AzureBlob = new AzureBlobSettings
            {
                TenantId = formAzureTenantId ?? string.Empty,
                ClientId = formAzureClientId ?? string.Empty,
                AccountName = formAzureAccountName ?? string.Empty,
                ContainerName = formAzureContainerName ?? string.Empty
            }
        }
    };

    private async Task SaveAsync()
    {
        saveError = null;
        validationErrors.Clear();
        showRegenerateOffer = false;
        regenerateSummary = null;
        regenerateFailures.Clear();

        // M5a.1: never write the form's own value for a policy-controlled field — MergeForSave
        // takes those fields from the pre-policy-overlay StoredSettings instead (or this machine's
        // defaults, if there is no stored environment.json yet), so a policy-locked field round-trips
        // through Save unchanged rather than freezing in the policy's current value.
        var formSettings = BuildFormSettings();
        var merged = EnvironmentSettingsResolver.MergeForSave(
            formSettings, effective?.StoredSettings, EnvironmentSettingsService.GetMachineDefaults(), policyFields);

        var errors = EnvironmentSettingsResolver.Validate(merged);
        if (errors.Count > 0)
        {
            validationErrors = errors.ToList();
            return;
        }

        // The TRUE effective fingerprint of the merged write — re-overlays policy on top of it, so
        // a policy-controlled field (whose merged value is the pre-policy one) is correctly folded
        // back to what the very next read will actually resolve to.
        var newFingerprint = EnvironmentSettingsService.ComputeEffectiveFingerprint(merged);
        var oldFingerprint = effective?.DistributionFingerprint;
        var oldEnabled = effective?.Settings?.Distribution.Enabled ?? false;

        if (EnvironmentChangeRules.RequiresRetargetConfirmation(oldFingerprint, oldEnabled, newFingerprint))
        {
            // Display-only: the merged settings with policy fields folded back to their CURRENT
            // effective values (not the pre-policy ones MergeForSave used for the write) — the same
            // reuse of MergeForSave with different "stored" values, purely for an accurate message.
            var displaySettings = EnvironmentSettingsResolver.MergeForSave(
                merged, effective?.Settings, EnvironmentSettingsService.GetMachineDefaults(), policyFields);

            var oldTarget = effective?.Settings != null
                ? EnvironmentSettingsService.DescribeDistributionTarget(effective.Settings.Distribution, EnvironmentContext.DataPath)
                : "nothing";
            var newTarget = newFingerprint != null
                ? EnvironmentSettingsService.DescribeDistributionTarget(displaySettings.Distribution, EnvironmentContext.DataPath)
                : "nothing (distribution disabled)";

            retargetMessage =
                $"Clients currently receive content from {oldTarget}. After this change they will stop receiving " +
                $"updates until they are reconfigured to {newTarget}. Continue?";
            pendingSettings = merged;
            pendingNewFingerprint = newFingerprint;
            showRetargetConfirm = true;
            return;
        }

        await DoSaveAsync(merged, newFingerprint);
    }

    private async Task ConfirmSaveAsync()
    {
        showRetargetConfirm = false;
        if (pendingSettings == null)
            return;

        var settings = pendingSettings;
        var fingerprint = pendingNewFingerprint;
        pendingSettings = null;
        pendingNewFingerprint = null;

        await DoSaveAsync(settings, fingerprint);
    }

    private void CancelRetarget()
    {
        showRetargetConfirm = false;
        pendingSettings = null;
        pendingNewFingerprint = null;
    }

    private async Task DoSaveAsync(EnvironmentSettings settings, string? newFingerprint)
    {
        isSaving = true;
        var oldFingerprint = effective?.DistributionFingerprint;
        try
        {
            // M5a.1: no longer calls EnvironmentDirectory.UpdateCurrentFingerprintAsync directly —
            // EnvironmentSettingsService.SaveAsync raises SettingsChanged, which
            // EnvironmentDirectoryService now handles itself (updating the fingerprint for every
            // save, not just ones made through this page), so this covers the same ground without
            // this page needing to know about the shared directory at all.
            await EnvironmentSettingsService.SaveAsync(settings);

            await LoadReadOnlySectionsAsync();
            FillFormFromEffective(); // the save just succeeded — nothing is "unsaved" any more.

            if (newFingerprint != null && !string.Equals(oldFingerprint, newFingerprint, StringComparison.Ordinal))
                showRegenerateOffer = true;
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RegenerateAllAsync()
    {
        isRegenerating = true;
        try
        {
            var result = await IndexService.RegenerateAllIndexesAsync();
            // Teams whose index could not be generated at all (e.g. an unreadable signing key) are listed with
            // the distribution failures so they are not silently skipped.
            regenerateFailures = result.DistributionFailures.Concat(result.Failures.Select(f => $"not regenerated - {f}")).ToList();
            regenerateSummary = regenerateFailures.Count == 0
                ? $"Regenerated {result.Regenerated} team index(es), 0 distribution failures."
                : $"Regenerated {result.Regenerated} team index(es), {regenerateFailures.Count} failure(s):";
        }
        catch (Exception ex)
        {
            regenerateFailures.Clear();
            regenerateSummary = $"Regeneration failed: {ex.Message}";
        }
        finally
        {
            isRegenerating = false;
        }
    }

    private async Task RunTestAsync()
    {
        testResult = null;
        isTesting = true;
        try
        {
            if (string.Equals(formMode, "AzureBlob", StringComparison.OrdinalIgnoreCase))
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));
                var azureSettings = new AzureBlobSettings
                {
                    TenantId = formAzureTenantId ?? string.Empty,
                    ClientId = formAzureClientId ?? string.Empty,
                    AccountName = formAzureAccountName ?? string.Empty,
                    ContainerName = formAzureContainerName ?? string.Empty
                };
                testResult = await AzureBlobDistributionService.TestContainerAsync(azureSettings, cts.Token);
            }
            else
            {
                testResult = await TestLocalRootAsync(formLocalPath);
            }
        }
        catch (Exception ex)
        {
            testResult = ex.Message;
        }
        finally
        {
            isTesting = false;
        }
    }

    private async Task<string> TestLocalRootAsync(string? localPath)
    {
        var root = string.IsNullOrWhiteSpace(localPath)
            ? Path.Combine(EnvironmentContext.DataPath, "_distribution")
            : localPath;

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        try
        {
            if (!Directory.Exists(root))
                return $"Folder does not exist: {root}";

            var testFile = Path.Combine(root, $".newscentral-write-test-{Guid.NewGuid()}.tmp");
            await File.WriteAllTextAsync(testFile, "test", cts.Token);
            File.Delete(testFile);
            return "OK";
        }
        catch (OperationCanceledException)
        {
            return "Timed out after 10 seconds.";
        }
        catch (Exception ex)
        {
            return ex.Message;
        }
    }

    // ── M5b — Initialize an environment ───────────────────────────────────────

    private IReadOnlyList<EnvironmentOption> OtherEnvironmentOptions =>
        EnvironmentDirectory.GetOptions(includeHidden: true).Where(o => !o.IsCurrent).ToList();

    // Picking an option only fills the Path input — nothing is probed until Initialize… is clicked.
    private void PickOtherEnvironment(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (!string.IsNullOrEmpty(value))
            initPath = value;
    }

    private async Task InitializeTargetAsync()
    {
        initError = null;
        initCreated = false;
        isInitializingTarget = true;
        try
        {
            var pathErrors = EnvironmentInitializationValidator.ValidateTargetPath(initPath);
            if (pathErrors.Count > 0)
            {
                initError = pathErrors[0];
                return;
            }

            var probe = await EnvironmentProbe.ProbeAsync(initPath, TimeSpan.FromSeconds(10));

            if (probe.TimedOut)
            {
                initError = "Timed out while checking that path. Check that it is reachable.";
                return;
            }
            if (probe.Error != null)
            {
                initError = probe.Error;
                return;
            }
            if (!probe.Exists)
            {
                initError = "Folder does not exist or is not accessible.";
                return;
            }
            if (probe.Initialized)
            {
                initError = "This environment is already initialized.";
                return;
            }

            // The probe above already confirmed reachability and non-initialization — the wizard
            // itself, and EnvironmentInitializer, never probe the path again.
            initWizardTargetPath = initPath;
            showInitWizard = true;
        }
        finally
        {
            isInitializingTarget = false;
        }
    }

    private async Task HandleInitWizardCreated(InitializeResult result)
    {
        showInitWizard = false;
        initCreated = true;
        initCreatedPath = initWizardTargetPath;

        // Picks up the directory entry EnvironmentInitializer just added (via AddAsync) so the
        // success panel's name matches what the picker now shows.
        await LoadReadOnlySectionsAsync();

        var added = EnvironmentDirectory.GetOptions(includeHidden: true)
            .FirstOrDefault(o => EnvironmentPaths.Canonicalize(o.DataPath) == EnvironmentPaths.Canonicalize(initCreatedPath));
        initCreatedName = added?.DisplayName ?? initCreatedPath;
    }

    private void HandleInitWizardCancelled() => showInitWizard = false;

    private void SwitchToInitialized()
    {
        if (initCreatedPath == null)
            return;

        EnvironmentDirectory.SwitchTo(initCreatedPath);
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    // ── M6 — Export fleet settings ────────────────────────────────────────────

    private async Task OpenExportDialogAsync()
    {
        if (!CanExportFleetSettings || effective?.Settings == null)
            return;

        exportSaveError = null;
        exportSavedPs1Path = null;
        exportSavedRegPath = null;
        exportSavedFolder = null;
        exportActiveTab = "powershell";

        var allTeams = await TeamService.GetAllTeamsAsync();
        var exportTeams = allTeams.Select(t => new FleetExportTeam(t.FolderName, t.Name)).ToList();

        // The same registry values Key Management shows (GpoTarget), so the export always matches the GPO.
        var keyLoad = await KeyService.LoadAsync();
        FleetExportSigning exportSigning;
        if (keyLoad.Outcome == KeyLoadOutcome.Unreadable)
        {
            exportSigning = new FleetExportSigning(null, null, keyLoad.Reason ?? "unknown reason");
        }
        else if (keyLoad.Keys is { } keys)
        {
            var (publicKey, publicKeyPrevious) = EnvironmentKeyService.GpoTarget(keys);
            exportSigning = new FleetExportSigning(publicKey, publicKeyPrevious);
        }
        else
        {
            exportSigning = new FleetExportSigning(null, null);
        }

        var distribution = effective.Settings.Distribution;
        var input = new FleetExportInput(
            Company: SolutionConstants.Company,
            EnvironmentDisplayName: string.IsNullOrWhiteSpace(current?.DisplayName) ? EnvironmentContext.DataPath : current!.DisplayName,
            DataPath: EnvironmentContext.DataPath,
            GeneratedAtUtc: DateTime.UtcNow,
            Distribution: new FleetExportDistribution(
                distribution.Enabled,
                distribution.Mode,
                distribution.LocalPath,
                distribution.AzureBlob.TenantId,
                distribution.AzureBlob.AccountName,
                distribution.AzureBlob.ContainerName),
            // Same helper MainLayout/Settings use for display — already resolves the
            // {DataPath}\_distribution fallback for Local mode (ignored by the builder for Azure).
            EffectiveLocalDistributionPath: EnvironmentSettingsService.DescribeDistributionTarget(distribution, EnvironmentContext.DataPath),
            Signing: exportSigning,
            Teams: exportTeams);

        exportResult = FleetExportBuilder.Build(input);
        showExportDialog = true;
    }

    private void CloseExportDialog()
    {
        showExportDialog = false;
        exportResult = null;
    }

    private async Task CopyExportTextAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            exportCopyFeedback = "Copied.";
        }
        catch
        {
            exportCopyFeedback = "Couldn't copy to the clipboard.";
        }

        StateHasChanged();
        await Task.Delay(2000);
        exportCopyFeedback = null;
        StateHasChanged();
    }

    private void SaveExportToDownloads()
    {
        if (exportResult == null)
            return;

        exportSaveError = null;
        try
        {
            var downloads = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(downloads);

            var slug = Slugify(current?.DisplayName ?? "environment");
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            var baseName = $"NewsCentral-fleet-{slug}-{stamp}";

            var ps1Path = Path.Combine(downloads, $"{baseName}.ps1");
            var regPath = Path.Combine(downloads, $"{baseName}.reg");

            // PowerShell 5.1 needs a BOM to reliably detect UTF-8; .reg is what regedit itself
            // writes (UTF-16 LE with BOM) — Encoding.Unicode is UTF-16 LE and includes the BOM.
            File.WriteAllText(ps1Path, exportResult.PowerShell, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true));
            File.WriteAllText(regPath, exportResult.Reg, Encoding.Unicode);

            exportSavedPs1Path = ps1Path;
            exportSavedRegPath = regPath;
            exportSavedFolder = downloads;
        }
        catch (Exception ex)
        {
            exportSaveError = ex.Message;
        }
    }

    private void OpenExportFolder()
    {
        if (exportSavedFolder == null)
            return;

        try
        {
            Process.Start(new ProcessStartInfo("explorer.exe") { ArgumentList = { exportSavedFolder } });
        }
        catch (Exception ex)
        {
            exportSaveError = $"Couldn't open the folder: {ex.Message}";
        }
    }

    private static string Slugify(string value)
    {
        var sb = new StringBuilder();
        foreach (var ch in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(ch))
                sb.Append(ch);
            else if (sb.Length > 0 && sb[^1] != '-')
                sb.Append('-');
        }

        var slug = sb.ToString().Trim('-');
        return string.IsNullOrEmpty(slug) ? "environment" : slug;
    }
