@page "/key-management"
@using NewsCentral.Configuration
@using NewsCentral.Models
@using NewsCentral.Security
@using NewsCentral.Components.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<KeyManagement> Localizer
@inject EnvironmentKeyService KeyService
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["PageTitle"]</h1>
        <p class="page-description">@Localizer["PageDescription"]</p>
    </div>

    @if (!isAuthorized)
    {
        <div class="alert alert-danger">
            <strong>@Localizer["AccessDenied"]</strong>
            <p>@Localizer["AccessDeniedMessage"]</p>
        </div>
        return;
    }

    <AclDriftWarnings />

    @if (keyUnreadable)
    {
        @* Unreadable is never offered as "no key": replacing it would orphan every device that trusts it. *@
        <div class="alert alert-danger">
            <i class="bi bi-lock me-2"></i>
            <strong>@Localizer["UnreadableTitle"]</strong>
            @Localizer["UnreadableMessage", keyLoad!.Reason ?? ""]
        </div>
        <button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@isBusy">
            <i class="bi bi-arrow-clockwise me-2"></i>@Localizer["Reload"]
        </button>
    }
    else if (keys?.Current == null)
    {
        <div class="card mb-4">
            <div class="card-header"><h5>@Localizer["NoKeySection"]</h5></div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["NoKeyConfigured"]
                </div>
                <p>@Localizer["GenerateDescription"]</p>
                <button class="btn btn-primary" @onclick='() => RunAsync(KeyService.GenerateAsync, "GeneratedOk")' disabled="@isBusy">
                    <i class="bi bi-plus-circle me-2"></i>@Localizer["Generate"]
                </button>
            </div>
        </div>
    }
    else
    {
        @* ── Keys ─────────────────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5>@Localizer["CurrentKey"]</h5></div>
            <div class="card-body">
                @KeySummary(keys.Current.PublicKey, keys.Current.CreatedAt)
            </div>
        </div>

        if (keys.Next != null)
        {
            <div class="card mb-4">
                <div class="card-header"><h5>@Localizer["NextKey"]</h5></div>
                <div class="card-body">
                    @KeySummary(keys.Next.PublicKey, keys.Next.CreatedAt)
                </div>
            </div>
        }

        if (!string.IsNullOrEmpty(keys.PreviousPublicKey))
        {
            <div class="card mb-4">
                <div class="card-header"><h5>@Localizer["PreviousKey"]</h5></div>
                <div class="card-body">
                    <div class="mb-1"><strong>@Localizer["KeyId"]:</strong> <code>@KeyFingerprint.Of(keys.PreviousPublicKey)</code></div>
                    <div class="text-muted">@Age(keys.PreviousCreatedAt)</div>
                </div>
            </div>
        }

        @* ── Registry values ─────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5>@Localizer["GpoSection"]</h5></div>
            <div class="card-body">
                <p class="mb-3">@StepExplanation()</p>
                @foreach (var component in new[] { "NewsService", "NewsViewer" })
                {
                    <h6 class="font-monospace">HKLM\Software\@SolutionConstants.Company\NewsCentral\@component\Signing</h6>
                    <div class="mb-3">
                        <label class="form-label fw-bold">PublicKey</label>
                        @GpoValue(gpo.PublicKey)
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">PublicKeyPrevious</label>
                        @if (gpo.PublicKeyPrevious == null)
                        {
                            <div class="text-muted">@Localizer["GpoRemovePrevious"]</div>
                        }
                        else
                        {
                            @GpoValue(gpo.PublicKeyPrevious)
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Actions: only those valid for the current state ─────────────── *@
        <div class="card mb-4">
            <div class="card-header"><h5>@Localizer["ActionsSection"]</h5></div>
            <div class="card-body">
                @if (pendingAction != null)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>@ConfirmText(pendingAction)
                    </div>
                    <button class="btn btn-danger me-2" @onclick="ConfirmAsync" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        @Localizer["Confirm"]
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => pendingAction = null" disabled="@isBusy">
                        @Localizer["Cancel"]
                    </button>
                }
                else
                {
                    if (CanPrepare)
                    {
                        <button class="btn btn-secondary me-2" @onclick='() => pendingAction = "prepare"' disabled="@isBusy">
                            <i class="bi bi-plus-circle me-2"></i>@Localizer["PrepareNext"]
                        </button>
                    }
                    if (keys.Next != null)
                    {
                        <button class="btn btn-warning me-2" @onclick='() => pendingAction = "activate"' disabled="@(isBusy || !CanActivate)">
                            <i class="bi bi-arrow-repeat me-2"></i>@Localizer["ActivateNext"]
                        </button>
                        <button class="btn btn-outline-secondary me-2" @onclick='() => pendingAction = "discard"' disabled="@isBusy">
                            <i class="bi bi-x-circle me-2"></i>@Localizer["DiscardNext"]
                        </button>
                    }
                    if (!string.IsNullOrEmpty(keys.PreviousPublicKey))
                    {
                        <button class="btn btn-outline-danger me-2" @onclick='() => pendingAction = "retire"' disabled="@isBusy">
                            <i class="bi bi-trash me-2"></i>@Localizer["RetirePrevious"]
                        </button>
                    }
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(copyFeedback))
    {
        <div class="alert alert-info py-1 mt-2">
            <i class="bi bi-check me-1"></i>@copyFeedback
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            @if (showIndexLink)
            {
                <a href="index-management" class="alert-link ms-2">@Localizer["GoToIndexManagement"]</a>
            }
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
</div>

@code {
    private bool isAuthorized;
    private SigningKeyLoadResult? keyLoad;
    private EnvironmentSigningKeys? keys;
    private string? loadedKeyId;      // fingerprint of Current when the page loaded; every action sends it back
    private bool isBusy;
    private string? pendingAction;    // prepare, activate, discard or retire: waiting for confirmation
    private string? copyFeedback;
    private string? successMessage;
    private bool showIndexLink;
    private string? errorMessage;

    private bool keyUnreadable => keyLoad?.Outcome == KeyLoadOutcome.Unreadable;
    private bool CanPrepare => keys?.Current != null && keys.Next == null && string.IsNullOrEmpty(keys.PreviousPublicKey);
    private bool CanActivate => keys?.Next != null && string.IsNullOrEmpty(keys.PreviousPublicKey);
    private (string? PublicKey, string? PublicKeyPrevious) gpo =>
        keys == null ? (null, null) : EnvironmentKeyService.GpoTarget(keys);

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.GetCurrentUser() == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isAuthorized = AuthService.IsSystemAdmin();
        if (!isAuthorized) return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            keyLoad = await KeyService.LoadAsync();
            keys = keyLoad.Keys;
            loadedKeyId = KeyFingerprint.Of(keys?.Current?.PublicKey);
            pendingAction = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["LoadError"]}: {ex.Message}";
        }
    }

    private async Task ConfirmAsync()
    {
        switch (pendingAction)
        {
            case "prepare": await RunAsync(KeyService.PrepareNextAsync, "PreparedOk"); break;
            case "activate": await RunAsync(KeyService.ActivateNextAsync, "ActivatedOk", showLink: true); break;
            case "discard": await RunAsync(KeyService.DiscardNextAsync, "DiscardedOk"); break;
            case "retire": await RunAsync(KeyService.RetirePreviousAsync, "RetiredOk"); break;
        }
    }

    private async Task RunAsync(Func<string?, Task<EnvironmentSigningKeys>> action, string successKey, bool showLink = false)
    {
        if (isBusy) return;

        try
        {
            isBusy = true;
            successMessage = null;
            errorMessage = null;
            StateHasChanged();

            keys = await action(loadedKeyId);
            keyLoad = SigningKeyLoadResult.Loaded(keys);
            loadedKeyId = KeyFingerprint.Of(keys.Current?.PublicKey);
            pendingAction = null;
            successMessage = Localizer[successKey];
            showIndexLink = showLink;
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["ActionError"]}: {ex.Message}";
            await ReloadAsync();   // show what is actually on disk now
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private string StepExplanation() => keys switch
    {
        { Next: not null } => Localizer["StepNextPrepared"],
        { PreviousPublicKey: not null } => Localizer["StepPreviousKept"],
        _ => Localizer["StepCurrentOnly"]
    };

    private string ConfirmText(string action) => action switch
    {
        "prepare" => Localizer["PrepareConfirm"],
        "activate" => Localizer["ActivateConfirm"],
        "discard" => Localizer["DiscardConfirm"],
        _ => Localizer["RetireConfirm"]
    };

    private string Age(DateTime? createdUtc)
    {
        if (createdUtc is null) return Localizer["AgeUnknown"];
        var days = Math.Max(0, (int)(DateTime.UtcNow - createdUtc.Value).TotalDays);
        var date = createdUtc.Value.ToString("yyyy-MM-dd");
        return days switch
        {
            0 => Localizer["AgeToday", date],
            1 => Localizer["AgeOneDay", date],
            _ => Localizer["AgeDays", date, days]
        };
    }

    private RenderFragment KeySummary(string? publicKey, DateTime? createdAt) => __builder =>
    {
        <div class="mb-1"><strong>@Localizer["KeyId"]:</strong> <code>@KeyFingerprint.Of(publicKey)</code></div>
        <div class="text-muted mb-3">@Age(createdAt)</div>
        <label class="form-label fw-bold">@Localizer["PublicKey"]</label>
        @GpoValue(publicKey)
    };

    private RenderFragment GpoValue(string? value) => __builder =>
    {
        <div class="input-group">
            <input type="text" class="form-control font-monospace" readonly value="@value" />
            <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboardAsync(value!)">
                <i class="bi bi-clipboard me-1"></i>@Localizer["CopyForGPO"]
            </button>
        </div>
    };

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copyFeedback = Localizer["Copied"];
        }
        catch
        {
            copyFeedback = Localizer["CopyFailed"];
        }

        StateHasChanged();
        await Task.Delay(2000);
        copyFeedback = null;
        StateHasChanged();
    }
}
