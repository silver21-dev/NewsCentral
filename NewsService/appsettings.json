  },
  "Hmac": {
    "SecretKey": ""
  },
  "Signing": {
    "RequireSignedIndex": false
  },
  "Entra": {
    "Enabled": false,
    "GracePeriodMinutes": 240,
    "MaxDynamicTeams": 16,
    "AttributeSchemes": {},
    "GroupTeams": {
      "ExclusionGroup": "",
